NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ADMIN_USER_ID is the primary identity check. ADMIN_EMAIL is used only when
# ADMIN_USER_ID is empty.
ADMIN_USER_ID=00000000-0000-0000-0000-000000000000
ADMIN_EMAIL=admin@example.com

# Optional additional env allowlists (comma/semicolon-separated). Usually manage
# staff in /admin/team instead; only the owner above can manage that private list.
ADMIN_USER_IDS=
ADMIN_EMAILS=

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Private owner chat; verified and linked by scripts/setup-telegram-bot.mjs.
# Webhook secrets are generated by that script and stored only as hashes in DB.
TELEGRAM_CHAT_ID=your-private-telegram-chat-id

# Vercel provides the production domain automatically for canonical URLs/sitemap.
# Optional override for a different deployment (hostname only, no trailing slash):
# VERCEL_PROJECT_PRODUCTION_URL=your-site.vercel.app
